#!/usr/bin/env python3
"""Executable ZEFM launcher; works when symlinked into /usr/local/bin."""
from pathlib import Path
import sys

# Resolve symlinks so /usr/local/bin/zefm can import the checked-out port.
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from zefm.__main__ import main

if __name__ == "__main__":
    main()
